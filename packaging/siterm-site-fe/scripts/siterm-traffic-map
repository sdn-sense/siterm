#!/usr/bin/env python3
"""Report per-port capacity, the active delta reservations using it, and what remains available.
Read-only: it only reads the database, local configuration and host reports; nothing is changed."""

import argparse
import contextlib
import json
import sys
from datetime import datetime, timezone

from SiteRMLibs.Backends.main import Switch
from SiteRMLibs.BWService import BWService
from SiteRMLibs.DefaultParams import SERVICE_DOWN_TIMEOUT
from SiteRMLibs.GitConfig import getGitConfig
from SiteRMLibs.ipaddr import replaceSpecialSymbols
from SiteRMLibs.MainUtilities import (
    evaldict,
    getActiveDeltas,
    getAllHosts,
    getDBConn,
    getSiteNameFromConfig,
    getUTCnow,
    getVal,
)
from SiteRMLibs.timing import Timing

L2_SECTIONS = ("vsw", "singleport", "kube")
L3_SECTION = "rst"
GUARANTEED = "guaranteedCapped"
STATE_ORDER = {"running": 0, "scheduled": 1, "ended": 2}
DEVICE_ORDER = {"switch": 0, "host": 1, "unknown": 2}
PORT_HEADER = ["PORT", "CAPACITY", "RESERVABLE", "USED", "GUARANTEED", "AVAIL", "FLAGS", "VLANS FREE"]
EPILOG = """
Used counts reservations running at the chosen time, of every QoS type (vsw, singleport and kube), like the delta
admission check. GUARANTEED is the guaranteedCapped part of it, the only type that reserves QoS bandwidth on a switch.
L3 (rst) services carry no port in active deltas: they are listed per device and not subtracted from any port.
VLANS FREE is per device at the chosen time, so the VLAN of a scheduled request shows as free until it starts.

Flags: UNKNOWN-PORT    a request uses a port missing from the inventory (down, ignored or removed from config)
       NO-CAPACITY     the port reports no capacity, so availability is unknown
       OVERSUBSCRIBED  running reservations exceed the reservable capacity
       BAD-RATE        a reservation has a rate that cannot be parsed and counts as 0
       STALE           the host agent has not reported recently, its capacity may be outdated

Examples:
  siterm-traffic-map
  siterm-traffic-map --device sw1 --used-only
  siterm-traffic-map --at 2026-12-01T00:00:00
  siterm-traffic-map --json
"""


def _dict(value):
    """Return value if it is a dict, otherwise an empty dict."""
    return value if isinstance(value, dict) else {}


def _int(value, default=0):
    """Return value as int, or default if it is not a number."""
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def _children(parent):
    """Yield (key, dict) for each nested level of a delta, skipping _params and scalar values."""
    for key, value in _dict(parent).items():
        if isinstance(value, dict) and not str(key).startswith("_"):
            yield str(key), value


def parseTime(value):
    """Return epoch seconds from an epoch or ISO-8601 string (UTC unless it carries an offset)."""
    try:
        return int(value)
    except ValueError:
        pass
    try:
        parsed = datetime.fromisoformat(value)
    except ValueError as ex:
        raise argparse.ArgumentTypeError(f"{value} is neither epoch seconds nor ISO-8601") from ex
    return int((parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)).timestamp())


def lifetime(*levels):
    """Return the (start, end) window in which all delta levels exist."""
    start, end = Timing.default_timings
    for level in levels:
        timing = _dict(_dict(level.get("_params")).get("existsDuring"))
        start = max(start, _int(timing.get("start"), start))
        end = min(end, _int(timing.get("end"), end))
    return start, end


def stateAt(window, at):
    """Return running, scheduled or ended for a lifetime window at a given time."""
    if at < window[0]:
        return "scheduled"
    if at > window[1]:
        return "ended"
    return "running"


def rateMbps(service):
    """Return the reserved rate in Mbit/s using SiteRM's own conversion, or None if it cannot be parsed."""
    try:
        rate, unit = BWService.convertToRate(service)
    except Exception:  # pylint: disable=broad-except
        # convertToRate raises a bare Exception for an unknown unit.
        return None
    # Its "bit" result for rates under 1 Mbit/s is actually in Kbit/s.
    return rate if unit == "mbit" else rate / 1000


def networkStatus(*levels):
    """Return the most specific network status reported by the given delta levels."""
    for level in levels:
        service = _dict(level.get("hasService"))
        for status in (_dict(level.get("_params")).get("networkstatus"), _dict(service.get("_params")).get("networkstatus"), service.get("networkstatus")):
            if status:
                return str(status)
    return "unset"


def routesOf(entry, iptype):
    """Return from, to and nextHop values for each route of an L3 entry."""
    routes = []
    for _, route in _children(entry.get("hasRoute")):
        routes.append(
            {
                "from": _dict(_dict(route.get("routeFrom")).get(f"{iptype}-prefix-list")).get("value"),
                "to": _dict(_dict(route.get("routeTo")).get(f"{iptype}-prefix-list")).get("value"),
                "nextHop": _dict(_dict(route.get("nextHop")).get(f"{iptype}-address")).get("value"),
            }
        )
    return routes


def reservationsOf(section, requestId, request, at):
    """Return the normalized reservations of a request: one per device port (L2) or address family (L3)."""
    items = []
    for device, ports in _children(request):
        for name, entry in _children(ports):
            service = _dict(entry.get("hasService"))
            window = lifetime(request, entry)
            item = {
                "request": requestId,
                "section": section,
                "device": device,
                "port": name,
                "vlan": _int(_dict(entry.get("hasLabel")).get("value"), None),
                "type": str(service.get("type") or "unset"),
                "rate": rateMbps(service),
                "status": networkStatus(entry, request),
                "state": stateAt(window, at),
                "start": window[0],
                "end": window[1],
            }
            if section == L3_SECTION:
                item["routes"] = routesOf(entry, name)
            items.append(item)
    return items


def collectRequests(active, at):
    """Return {request id: summary and reservations} for all L2 and L3 sections of active deltas."""
    requests = {}
    for section in (*L2_SECTIONS, L3_SECTION):
        for requestId, request in _children(active.get(section)):
            window = lifetime(request)
            requests[requestId] = {
                "section": section,
                "status": networkStatus(request),
                "state": stateAt(window, at),
                "start": window[0],
                "end": window[1],
                "reservations": reservationsOf(section, requestId, request, at),
            }
    return requests


def newPort(name, capacity=None, reservable=None, vlanRange=None, flags=None):
    """Return an empty port record."""
    return {"name": name, "capacity": capacity or None, "reservable": reservable, "vlanRange": vlanRange, "flags": flags or [], "reservations": []}


def newDevice(kind, updated=None, ports=None, flags=None):
    """Return an empty device record."""
    return {"type": kind, "updated": updated, "ports": ports or {}, "flags": flags or [], "l3": []}


def vlanSet(values):
    """Return the set of VLAN ids in a list, ignoring anything that is not a number."""
    if not isinstance(values, list):
        return set()
    return {vlan for vlan in (_int(value, None) for value in values) if vlan is not None}


def compactVlans(vlans):
    """Return VLAN ids as a compact string like 3600-3605,3610."""
    ranges = []
    for vlan in sorted(vlans):
        if ranges and vlan == ranges[-1][1] + 1:
            ranges[-1][1] = vlan
        else:
            ranges.append([vlan, vlan])
    return ",".join(str(first) if first == last else f"{first}-{last}" for first, last in ranges)


def summarizePort(port, runningVlans, systemVlans):
    """Add used, available, VLAN and flag summaries to a port from its reservations."""
    usedByType = {}
    for item in port["reservations"]:
        if item["state"] == "running":
            usedByType[item["type"]] = usedByType.get(item["type"], 0) + (item["rate"] or 0)
    port["usedByType"] = usedByType
    port["used"] = sum(usedByType.values())
    port["guaranteed"] = usedByType.get(GUARANTEED, 0)
    port["available"] = None if port["reservable"] is None else port["reservable"] - port["used"]
    if port["capacity"] is None and "UNKNOWN-PORT" not in port["flags"]:
        port["flags"].append("NO-CAPACITY")
    if port["available"] is not None and port["available"] < 0:
        port["flags"].append("OVERSUBSCRIBED")
    if any(item["rate"] is None for item in port["reservations"]):
        port["flags"].append("BAD-RATE")
    vlanRange = vlanSet(port.pop("vlanRange"))
    free = vlanRange - runningVlans - systemVlans
    port["vlans"] = {"total": len(vlanRange), "free": len(free), "freeRanges": compactVlans(free), "otherOnDevice": sorted((systemVlans - runningVlans) & vlanRange)}


def buildDevices(devices, requests, active):
    """Attach reservations to inventory ports and summarize them; VLANs are shared per device, like in the model."""
    for request in requests.values():
        for item in request["reservations"]:
            device = devices.setdefault(item["device"], newDevice("unknown"))
            if item["section"] == L3_SECTION:
                device["l3"].append(item)
                continue
            port = device["ports"].setdefault(replaceSpecialSymbols(item["port"]), newPort(item["port"], flags=["UNKNOWN-PORT"]))
            # Deltas use the model's port name (Ethernet1-1); report the device's own (Ethernet1/1).
            item["port"] = port["name"]
            port["reservations"].append(item)
    systemVlans = _dict(_dict(active.get("usedVLANs")).get("system"))
    for name, device in devices.items():
        running = {item["vlan"] for port in device["ports"].values() for item in port["reservations"] if item["state"] == "running" and item["vlan"] is not None}
        for port in device["ports"].values():
            summarizePort(port, running, vlanSet(systemVlans.get(name)))
    return devices


class TrafficMap(BWService):
    """Read-only view of active delta reservations against device port capacity."""

    def __init__(self, at=None):
        super().__init__()
        self.config = getGitConfig()
        self.sitename = getSiteNameFromConfig(self.config)
        self.dbI = getVal(getDBConn("TrafficMap", self), sitename=self.sitename)
        self.switch = Switch(self.config, self.sitename)
        self.activeDeltas = getActiveDeltas(self)
        self.now = getUTCnow()
        self.at = self.now if at is None else at

    def _switchDevices(self):
        """Return all configured switches with the capacity, reservable share and VLAN range the model uses."""
        devices = {}
        info = self.switch.getinfo()
        for device in self.config.get(self.sitename, "switch"):
            ports = {}
            for name, data in _dict(info.get("ports", {}).get(device)).items():
                capacity = _int(data.get("capacity") or data.get("bandwidth"))
                reservable = self.bwCalculatereservableSwitch(self.config.config["MAIN"], device, name, capacity, nosubtract=True) if capacity else None
                ports[replaceSpecialSymbols(name)] = newPort(name, capacity, reservable, data.get("vlan_range_list"))
            updated = _dict(self.switch.switches["output"].get(device, {}).get("dbinfo")).get("updatedate")
            devices[device] = newDevice("switch", updated, ports)
        return devices

    def _hostDevices(self):
        """Return all hosts with the interface capacity their agent reports, net of its reserved capacity."""
        devices = {}
        for host, row in getAllHosts(self.dbI).items():
            hostinfo = evaldict(row.get("hostinfo", ""))
            agentConfig = _dict(_dict(hostinfo.get("Summary")).get("config"))
            ports = {}
            for intf, data in _children(_dict(hostinfo.get("NetInfo")).get("interfaces")):
                bwParams = _dict(data.get("bwParams"))
                if not bwParams:
                    continue
                capacity = _int(bwParams.get("maximumCapacity"))
                reservable = self.bwCalculatereservableServer(agentConfig, host, intf, capacity, nosubtract=True) if capacity else None
                ports[replaceSpecialSymbols(intf)] = newPort(intf, capacity, reservable, data.get("vlan_range_list"))
            updated = _int(row.get("updatedate"), None)
            stale = updated is None or self.now - updated > SERVICE_DOWN_TIMEOUT
            devices[host] = newDevice("host", updated, ports, ["STALE"] if stale else [])
        return devices

    def report(self):
        """Return the full traffic map as a JSON-serializable dict."""
        active = _dict(self.activeDeltas.get("output"))
        requests = collectRequests(active, self.at)
        devices = buildDevices({**self._hostDevices(), **self._switchDevices()}, requests, active)
        return {"site": self.sitename, "at": self.at, "generated": self.now, "activeDeltasUpdated": self.activeDeltas.get("updatedate"), "devices": devices, "requests": requests}


def filterReport(report, deviceName=None, usedOnly=False):
    """Limit a report to one device, and optionally to ports with reservations."""
    if deviceName:
        report["devices"] = {deviceName: report["devices"][deviceName]}
        report["requests"] = {key: val for key, val in report["requests"].items() if any(item["device"] == deviceName for item in val["reservations"])}
    if usedOnly:
        for device in report["devices"].values():
            device["ports"] = {key: port for key, port in device["ports"].items() if port["reservations"]}
        report["devices"] = {key: val for key, val in report["devices"].items() if val["ports"] or val["l3"]}
    return report


def fmtRate(mbps):
    """Return a rate in Mbit/s as a short string."""
    if mbps is None:
        return "?"
    if not mbps:
        return "0"
    return f"{mbps / 1000:g}G" if abs(mbps) >= 1000 else f"{mbps:g}M"


def fmtTime(timestamp):
    """Return epoch seconds as a UTC date and time."""
    return datetime.fromtimestamp(timestamp, timezone.utc).strftime("%Y-%m-%d %H:%M")


def fmtWindow(start, end):
    """Return a lifetime window as a string, with - for an open end."""
    first, last = Timing.default_timings
    return f"{'-' if start == first else fmtTime(start)} -> {'-' if end == last else fmtTime(end)}"


def fmtAge(seconds):
    """Return a duration as a short string."""
    for limit, unit in ((86400, "d"), (3600, "h"), (60, "m")):
        if seconds >= limit:
            return f"{seconds // limit}{unit}"
    return f"{seconds}s"


def shortId(requestId):
    """Return a request id without its common URN prefix."""
    return requestId.split("conn+", 1)[1] if "conn+" in requestId else ":".join(requestId.split(":")[-2:])


def alignRows(rows):
    """Return rows as strings with each column padded to its widest cell."""
    if not rows:
        return []
    widths = [max(len(str(row[idx])) for row in rows) for idx in range(len(rows[0]))]
    return ["  ".join(str(cell).ljust(width) for cell, width in zip(row, widths)).rstrip() for row in rows]


def sortedReservations(items):
    """Return reservations with running ones first, then by VLAN and port."""
    return sorted(items, key=lambda item: (STATE_ORDER[item["state"]], item["vlan"] or 0, item["port"]))


def renderReservation(item):
    """Return the table cells of one reservation under a port."""
    return [
        "   ",
        f"vlan {item['vlan'] if item['vlan'] is not None else '-'}",
        fmtRate(item["rate"]),
        item["type"],
        item["status"],
        item["state"],
        fmtWindow(item["start"], item["end"]),
        shortId(item["request"]),
    ]


def renderPort(port):
    """Return the table cells of one port."""
    vlans = port["vlans"]
    freeVlans = f"{vlans['free']}/{vlans['total']} {vlans['freeRanges']}".rstrip() if vlans["total"] else "-"
    return [
        port["name"],
        fmtRate(port["capacity"]),
        fmtRate(port["reservable"]),
        fmtRate(port["used"]),
        fmtRate(port["guaranteed"]),
        fmtRate(port["available"]),
        ",".join(port["flags"]) or "-",
        freeVlans,
    ]


def renderL3(device):
    """Return the lines of the L3 services of a device."""
    lines = []
    rows = [
        ["   ", item["port"], fmtRate(item["rate"]), item["type"], item["status"], item["state"], fmtWindow(item["start"], item["end"]), shortId(item["request"])]
        for item in sortedReservations(device["l3"])
    ]
    for row, item in zip(alignRows(rows), sortedReservations(device["l3"])):
        lines.append(row)
        for route in item.get("routes", []):
            lines.append(f"        from {route['from'] or 'any'} to {route['to'] or 'any'} via {route['nextHop'] or '-'}")
    return ["  L3 services (no port in active deltas, not subtracted above):", *lines] if lines else []


def renderDevice(name, device, now):
    """Return the lines of one device: its port table with the reservations under each port."""
    age = f"data age {fmtAge(max(now - device['updated'], 0))}" if device["updated"] else "no data timestamp"
    lines = ["", f"== {name} [{device['type']}] {age}{''.join(f' {flag}' for flag in device['flags'])}"]
    ports = sorted(device["ports"].values(), key=lambda port: port["name"])
    if not ports:
        lines.append("  no port data")
    else:
        rows = alignRows([PORT_HEADER, *(renderPort(port) for port in ports)])
        children = iter(alignRows([renderReservation(item) for port in ports for item in sortedReservations(port["reservations"])]))
        lines.append(rows[0])
        for row, port in zip(rows[1:], ports):
            lines.append(row)
            lines.extend(next(children) for _ in port["reservations"])
        otherVlans = {vlan for port in ports for vlan in port["vlans"]["otherOnDevice"]}
        if otherVlans:
            lines.append(f"  VLANs on device without a running request: {compactVlans(otherVlans)}")
    return lines + renderL3(device)


def renderRequests(requests):
    """Return the lines of the per-request view: every request and the device ports it uses."""
    lines = ["", "== Requests" if requests else "== No requests in active deltas"]
    ordered = sorted(requests.items(), key=lambda pair: (STATE_ORDER[pair[1]["state"]], pair[0]))
    headers = alignRows([[request["state"], request["section"], request["status"], fmtWindow(request["start"], request["end"]), requestId] for requestId, request in ordered])
    for header, (_, request) in zip(headers, ordered):
        lines.append(header)
        rows = [
            ["   ", f"{item['device']}:{item['port']}", f"vlan {item['vlan']}" if item["vlan"] is not None else "-", fmtRate(item["rate"]), item["type"], item["status"]]
            for item in request["reservations"]
        ]
        lines.extend(alignRows(sorted(rows, key=lambda row: row[1])))
    return lines


def renderText(report):
    """Return the human readable traffic map."""
    counts = {state: sum(1 for request in report["requests"].values() if request["state"] == state) for state in STATE_ORDER}
    updated = report["activeDeltasUpdated"]
    lines = [
        f"SiteRM traffic map for {report['site']} at {fmtTime(report['at'])} UTC",
        f"Active deltas updated {fmtTime(updated) + ' UTC' if updated else 'never'}. Requests: {counts['running']} running, {counts['scheduled']} scheduled, {counts['ended']} ended.",
        "Rates in bit/s. USED counts reservations running at that time, of every QoS type. AVAIL = RESERVABLE - USED.",
    ]
    for name, device in sorted(report["devices"].items(), key=lambda pair: (DEVICE_ORDER[pair[1]["type"]], pair[0])):
        lines.extend(renderDevice(name, device, report["generated"]))
    lines.extend(renderRequests(report["requests"]))
    return "\n".join(lines)


def parseArgs(argv=None):
    """Parse command line arguments."""
    parser = argparse.ArgumentParser(
        description="Report the traffic map of this SiteRM: per-port capacity, active delta usage and what remains available. Read-only.",
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--device", help="only report this device, and the requests using it")
    parser.add_argument("--used-only", action="store_true", dest="usedOnly", help="hide ports without reservations")
    parser.add_argument("--at", type=parseTime, help="evaluate reservations at this time: epoch seconds or ISO-8601, UTC by default (default: now)")
    parser.add_argument("--json", action="store_true", help="print the full report as JSON")
    return parser.parse_args(argv)


def main(argv=None):
    """Print the traffic map; return the process exit code."""
    args = parseArgs(argv)
    # SiteRMLibs prints diagnostics to stdout: keep them out of the report so --json stays parseable.
    with contextlib.redirect_stdout(sys.stderr):
        report = TrafficMap(args.at).report()
    if args.device and args.device not in report["devices"]:
        print(f"Device {args.device} not found. Known devices: {', '.join(sorted(report['devices']))}", file=sys.stderr)
        return 2
    report = filterReport(report, args.device, args.usedOnly)
    print(json.dumps(report, indent=2, sort_keys=True) if args.json else renderText(report))
    return 0


if __name__ == "__main__":
    sys.exit(main())
